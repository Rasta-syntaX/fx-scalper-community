# ─────────────────────────────────────────────
# FX Scalper Community Edition — Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Deriv API ─────────────────────────────────
DERIV_APP_ID=1089
DERIV_API_TOKEN=your_api_token_here
ACCOUNT_MODE=demo              # "demo" or "real"

# ── Trading ───────────────────────────────────
SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxGBPJPY,frxXAUUSD
MAX_TRADES=3
STAKE_AMOUNT=1
MAX_MULTIPLIER=100
TRADE_DIRECTION=both           # "buy", "sell", or "both"

# ── Daily Limits (0 = disabled) ───────────────
DAILY_PROFIT_TARGET=0
DAILY_LOSS_LIMIT=0

# ── Webhook Notifications (optional) ──────────
# Discord: Create a webhook in Server Settings → Integrations → Webhooks
# Paste the full webhook URL below.
DISCORD_WEBHOOK_URL=

# Telegram: Create a bot via @BotFather, get the token.
# Find your chat ID (send a message to the bot, then visit
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server ────────────────────────────────────
FLASK_DEBUG=1
FLASK_PORT=5000
